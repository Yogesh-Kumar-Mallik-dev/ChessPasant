{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ChessPasant",
  "version": "0.1.8",
  "identifier": "com.chesspasant.desktop",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChessPasant",
        "width": 1240,
        "height": 840,
        "minWidth": 850,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; media-src 'self' tauri: asset: data: blob: https:; connect-src 'self' https: http: ws: wss: ipc: tauri:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
