# Maintainer: Yogesh Kumar Mallik <yogeshkumarmallikdev@gmail.com>
pkgname=chesspasant-bin
pkgver=0.1.9
pkgrel=1
pkgdesc="Modern, distraction-free chess platform and Stockfish 19 Game Review Studio"
arch=('x86_64')
url="https://github.com/Yogesh-Kumar-Mallik-dev/ChessPasant"
license=('MIT')
depends=('gtk3' 'glib2' 'openssl')
optdepends=('stockfish: for external UCI system engine calculation')
provides=('chesspasant')
conflicts=('chesspasant')
source=("https://github.com/Yogesh-Kumar-Mallik-dev/ChessPasant/releases/download/v${pkgver}/ChessPasant_${pkgver}_x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/chesspasant-${pkgver}"
    
    install -Dm755 "chesspasant" "${pkgdir}/usr/bin/chesspasant"
    if [ -f "stockfish" ]; then
        install -Dm755 "stockfish" "${pkgdir}/usr/lib/chesspasant/stockfish"
    fi
    install -Dm644 "chesspasant.desktop" "${pkgdir}/usr/share/applications/chesspasant.desktop"
    
    if [ -f "icons/512x512.png" ]; then
        install -Dm644 "icons/512x512.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/chesspasant.png"
    fi
    if [ -f "icons/128x128.png" ]; then
        install -Dm644 "icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/chesspasant.png"
    fi
    if [ -f "icons/32x32.png" ]; then
        install -Dm644 "icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/chesspasant.png"
    fi
}
